        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Health check",
        "description": "No key needed. Checks the database too.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "time"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/parse": {
      "post": {
        "tags": [
          "Parse"
        ],
        "summary": "Parse a CSV now",
        "description": "Reads a bank CSV (up to 1 MB) and returns the transactions. Send the raw file in any encoding, or JSON with a `csv` string. For bigger files, or to be notified by webhook, create a job instead.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "YMD",
                "DMY",
                "MDY"
              ],
              "description": "Force the date order instead of detecting it."
            },
            "required": false,
            "description": "Force the date order instead of detecting it.",
            "name": "date_format",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                ".",
                ","
              ],
              "description": "Force the decimal separator."
            },
            "required": false,
            "description": "Force the decimal separator.",
            "name": "decimal",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "signed",
                "inverted",
                "split",
                "direction"
              ],
              "description": "Force the sign convention."
            },
            "required": false,
            "description": "Force the sign convention.",
            "name": "sign",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                ",",
                ";",
                "tab",
                "|"
              ]
            },
            "required": false,
            "name": "delimiter",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 4,
              "description": "Digits after the decimal point. Default 2."
            },
            "required": false,
            "description": "Digits after the decimal point. Default 2.",
            "name": "minor_units",
            "in": "query"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
                "format": "binary",
                "example": "Date,Description,Amount\n2026-01-02,Coffee,-4.50\n"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transactions, skipped rows and how the file was read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The request was invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or daily quota reached",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Create a parse job",
        "description": "Queues a file (up to 4 MB) and returns at once. Poll the job, or subscribe a webhook endpoint to `job.succeeded` and `job.failed`. Send an `Idempotency-Key` header so a retried request never creates a second job.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "YMD",
                "DMY",
                "MDY"
              ],
              "description": "Force the date order instead of detecting it."
            },
            "required": false,
            "description": "Force the date order instead of detecting it.",
            "name": "date_format",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                ".",
                ","
              ],
              "description": "Force the decimal separator."
            },
            "required": false,
            "description": "Force the decimal separator.",
            "name": "decimal",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "signed",
                "inverted",
                "split",
                "direction"
              ],
              "description": "Force the sign convention."
            },
            "required": false,
            "description": "Force the sign convention.",
            "name": "sign",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                ",",
                ";",
                "tab",
                "|"
              ]
            },
            "required": false,
            "name": "delimiter",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 4,
              "description": "Digits after the decimal point. Default 2."
            },
            "required": false,
            "description": "Digits after the decimal point. Default 2.",
            "name": "minor_units",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "required": false,
            "name": "filename",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 200,
              "example": "import-2026-01-statement"
            },
            "required": false,
            "name": "idempotency-key",
