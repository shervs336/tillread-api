  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API key from the console: `Authorization: Bearer tr_live_…`"
      }
    },
    "schemas": {
      "ParseResult": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "date",
                    "amount",
                    "zero"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "line",
                "reason",
                "message"
              ]
            }
          },
          "detection": {
            "$ref": "#/components/schemas/Detection"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          }
        },
        "required": [
          "transactions",
          "skipped",
          "detection",
          "summary"
        ]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-01-02"
          },
          "amount": {
            "type": "integer",
            "example": -450,
            "description": "Minor units (cents). Negative is money out."
          },
          "description": {
            "type": "string",
            "example": "Blue Bottle Coffee"
          },
          "memo": {
            "type": "string"
          },
          "balance": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "category": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "example": 2
          }
        },
        "required": [
          "date",
          "amount",
          "description",
          "line"
        ]
      },
      "Detection": {
        "type": "object",
        "properties": {
          "delimiter": {
            "type": "string"
          },
          "headerRow": {
            "type": [
              "integer",
              "null"
            ]
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "dateFormat": {
            "type": "string",
            "enum": [
              "YMD",
              "DMY",
              "MDY"
            ]
          },
          "decimal": {
            "type": "string",
            "enum": [
              ".",
              ","
            ]
          },
          "sign": {
            "type": "string",
            "enum": [
              "signed",
              "inverted",
              "split",
              "direction"
            ]
          },
          "order": {
            "type": "string",
            "enum": [
              "ascending",
              "descending",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "example": 0.95
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "delimiter",
          "headerRow",
          "headers",
          "columns",
          "dateFormat",
          "decimal",
          "sign",
          "order",
          "confidence",
          "notes",
          "warnings"
        ]
      },
      "Summary": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          },
          "money_in": {
            "type": "integer"
          },
          "money_out": {
            "type": "integer"
          },
          "first_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number"
          }
        },
        "required": [
          "transactions",
          "skipped",
          "money_in",
          "money_out",
          "first_date",
          "last_date",
          "confidence"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://tillread-api.vercel.app/docs#errors-rate_limited"
