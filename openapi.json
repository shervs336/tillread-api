          },
          "request_id": {
            "type": "string",
            "example": "req_8fK2mQx9TzLw"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "description": "An error, as Problem Details for HTTP APIs (RFC 9457)."
      },
      "ParseRequest": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string",
            "minLength": 1,
            "example": "Date,Description,Amount\n2026-01-02,Coffee,-4.50\n"
          },
          "options": {
            "type": "object",
            "properties": {
              "date_format": {
                "type": "string",
                "enum": [
                  "YMD",
                  "DMY",
                  "MDY"
                ],
                "description": "Force the date order instead of detecting it."
              },
              "decimal": {
                "type": "string",
                "enum": [
                  ".",
                  ","
                ],
                "description": "Force the decimal separator."
              },
              "sign": {
                "type": "string",
                "enum": [
                  "signed",
                  "inverted",
                  "split",
                  "direction"
                ],
                "description": "Force the sign convention."
              },
              "delimiter": {
                "type": "string",
                "enum": [
                  ",",
                  ";",
                  "tab",
                  "|"
                ]
              },
              "minor_units": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 4,
                "description": "Digits after the decimal point. Default 2."
              }
            }
          }
        },
        "required": [
          "csv"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "job_3kTq9VwZp2Lx8NcR4bYe"
          },
          "object": {
            "type": "string",
            "enum": [
              "job"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "succeeded",
              "failed"
            ]
          },
          "filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": "integer"
          },
          "options": {
            "type": "object",
            "additionalProperties": {}
          },
          "summary": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Summary"
              },
              {
                "type": [
                  "object",
                  "null"
                ]
              }
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "object",
          "status",
          "filename",
          "bytes",
          "options",
          "summary",
          "error",
          "created_at",
          "started_at",
          "finished_at"
        ]
      },
      "JobList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "has_more": {
            "type": "boolean"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "key": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "prefix"
            ]
          },
          "limits": {
            "type": "object",
            "properties": {
              "requests_per_minute": {
                "type": "integer"
              },
              "requests_per_day": {
                "type": "integer"
              },
              "jobs_per_day": {
                "type": "integer"
              }
            },
            "required": [
              "requests_per_minute",
              "requests_per_day",
              "jobs_per_day"
            ]
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string"
                },
                "requests": {
                  "type": "integer"
                },
                "rows_parsed": {
                  "type": "integer"
                },
                "jobs": {
                  "type": "integer"
                }
              },
              "required": [
                "day",
                "requests",
                "rows_parsed",
                "jobs"
              ]
            }
          }
        },
        "required": [
          "key",
          "limits",
          "days"
        ]
      },
      "WebhookEndpoint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "we_9QmV2tXc8RkLp4ZsHn1a"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "description": "Only returned when the endpoint is created. Use it to verify signatures."
          }
        },
        "required": [
          "id",
          "url",
          "events",
          "description",
          "created_at"
        ]
      },
      "CreateWebhookEndpoint": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/webhooks/tillread"
          },
