# Postgres connection string. On Supabase: Connect → Transaction pooler (port 6543).
# Leave empty locally to use an in-memory PGlite database.
DATABASE_URL=
# Any long random string. Vercel Cron sends it as a Bearer token to /api/cron/tick.
CRON_SECRET=
# Optional: signs console cookies. Derived from DATABASE_URL when unset.
CONSOLE_SECRET=
